
VERSION="1.0.0"
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL Database ---
# Use 'localhost' for local development with Docker port mapping
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection Strings
# Pattern: driver://user:password@host:port/dbname
DATABASE_ASYNC_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/your_db_name
DATABASE_SYNC_URL=postgresql+psycopg2://your_db_user:your_db_password@localhost:5432/your_db_name

# --- Security & JWT ---
# Generate a new secret using: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Redis (Caching & Task Queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Mail Configuration (Mailhog/SMTP) ---
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@sheltly.com
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password

