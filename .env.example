
VERSION="1.0.0"
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=db.example.supabase.co
POSTGRES_PORT=5432

# Database Connection Strings
# Pattern: driver://user:password@host:port/dbname
# These are preferred when present and will automatically add sslmode=require for Supabase.
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@db.example.supabase.co:5432/postgres?sslmode=require
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@db.example.supabase.co:5432/postgres?sslmode=require

# For local Docker, switch to:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=postgres
# DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres

# --- Security & JWT ---
# Generate a new secret using: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Redis (Caching & Task Queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Mail Configuration (Mailhog/SMTP) ---
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@sheltly.com
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password

# --- Embedding backend ---
# Set to 'hf_inference_api' to use Hugging Face Inference API instead of downloading the model locally.
EMBEDDING_BACKEND=hf_inference_api
HF_API_TOKEN=your_hf_token_here
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Geocoding (radius search & distance-aware ranking) ---
# Location strings are resolved from our own listings first; 'nominatim'
# enables the OpenStreetMap fallback for unknown areas. Set to 'none' to
# disable external lookups entirely.
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_COUNTRY_CODES=ng
GEOCODE_CACHE_TTL_SECONDS=2592000



